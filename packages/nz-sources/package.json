{
  "name": "@nz-open-data-connectors/nz-sources",
  "version": "0.1.1",
  "license": "MIT",
  "description": "Keyless-first TypeScript clients for 14 New Zealand public data sources, with live probes and offline fixtures.",
  "keywords": ["new-zealand", "open-data", "api", "api-client", "typescript", "geonet", "stats-nz", "linz", "digitalnz", "arcgis"],
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo coverage",
    "clean:all": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo coverage node_modules",
    "test:smoke": "RUN_SMOKE=1 vitest run src/smoke.test.ts --testTimeout=30000"
  },
  "devDependencies": {
    "@nz-open-data-connectors/config-eslint": "*",
    "@nz-open-data-connectors/config-typescript": "*",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "zod": "3.25.76"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olitreadwell/nz-open-data-connectors.git"
  },
  "homepage": "https://github.com/olitreadwell/nz-open-data-connectors#readme",
  "bugs": {
    "url": "https://github.com/olitreadwell/nz-open-data-connectors/issues"
  }
}
