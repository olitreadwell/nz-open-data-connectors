{
  "name": "@nz-open-data-connectors/connectors-cli",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Command line tool for New Zealand open data. Prints JSON or CSV to stdout so any language can shell out to it.",
  "keywords": ["new-zealand", "open-data", "cli", "typescript", "data", "api"],
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "bin": {
    "nzdata": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo coverage",
    "clean:all": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo coverage node_modules"
  },
  "dependencies": {
    "@nz-open-data-connectors/nz-sources": "*",
    "@nz-open-data-connectors/stats-nz": "*"
  },
  "devDependencies": {
    "@nz-open-data-connectors/config-eslint": "*",
    "@nz-open-data-connectors/config-typescript": "*",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olitreadwell/nz-open-data-connectors.git"
  },
  "homepage": "https://github.com/olitreadwell/nz-open-data-connectors#readme",
  "bugs": {
    "url": "https://github.com/olitreadwell/nz-open-data-connectors/issues"
  }
}
