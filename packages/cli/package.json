{
  "name": "@nzlab/connectors-cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "nzdata": "./src/cli.ts"
  },
  "files": [
    "src/**"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "RUN_SMOKE=1 vitest run src/smoke.test.ts",
    "clean": "rm -rf tsconfig.tsbuildinfo coverage",
    "clean:all": "rm -rf tsconfig.tsbuildinfo coverage node_modules"
  },
  "dependencies": {
    "@nzlab/nz-sources": "*",
    "@nzlab/stats-nz": "*",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@nzlab/config-eslint": "*",
    "@nzlab/config-typescript": "*",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
